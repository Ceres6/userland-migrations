{
  "name": "@nodejs/expect-to-node-assert",
  "version": "1.0.0",
  "description": "Migrate assertions from Jest's expect to node:assert",
  "type": "module",
  "scripts": {
    "test": "node --run test:unit && node --run test:workflow && node --run test:package-json",
    "test:unit": "node --import=@nodejs/codemod-utils/codemod-jssg-context --test './src/**/*.test.ts'",
    "test:workflow": "npx codemod jssg test -l typescript ./src/workflow.ts ./tests/workflow",
    "test:package-json": "npx codemod jssg test -l json ./src/migrate-package-json.ts ./tests/package-json --allow-fs --allow-child-process"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodejs/userland-migrations.git",
    "directory": "recipes/expect-to-node-assert",
    "bugs": "https://github.com/nodejs/userland-migrations/issues"
  },
  "author": "Carlos Espa",
  "license": "MIT",
  "homepage": "https://github.com/nodejs/userland-migrations/blob/main/recipes/expect-to-node-assert/README.md",
  "devDependencies": {
    "@codemod.com/jssg-types": "^1.6.3"
  },
  "dependencies": {
    "@nodejs/codemod-utils": "*"
  }
}
