{
  "name": "inline-config",
  "scripts": {
    "test": "node --import tsx --import ./test/setup.ts --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.d.ts\" --test-concurrency=1 \"src/**/__tests__/**/*.?([mc])[jt]s?(x)\" \"src/**/?(*.)+(spec|test).?([mc])[jt]s?(x)\"",
    "test:watch": "node --import tsx --import ./test/setup.ts --test --watch \"src/**/__tests__/**/*.?([mc])[jt]s?(x)\" \"src/**/?(*.)+(spec|test).?([mc])[jt]s?(x)\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "expect": "^30.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
